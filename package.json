{
  "name": "video-repeat-studio",
  "version": "1.0.0",
  "description": "Professional Windows desktop app for seamless video repeat processing",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && electron-builder --win --x64",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "ffmpeg",
    "video",
    "repeat",
    "sqlite"
  ],
  "author": "Antigravity Team",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.8.0",
    "chokidar": "^4.0.3",
    "electron-updater": "^6.8.9",
    "fluent-ffmpeg": "^2.1.3",
    "lucide-react": "^0.474.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "systeminformation": "^5.25.11",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "electron": "^34.1.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.19.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.0.4"
  }
}
